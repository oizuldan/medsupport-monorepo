# Copy to .env (production) or .env.local (development) and fill in.

# --- Existing runtime/build config ---
BASE_URL="https://medsupport.kz/cms"
API_BASE_URL="https://medsupport.kz/api"
CMS_GRAPHQL_API_URL="https://medsupport.kz/cms/graphql"

# --- Contact + partner forms (Next API routes at /api/contact/*) ---
# SECRET. Read server-side only at runtime. Never add this to the `env` block in
# next.config.mjs — that inlines values into the client bundle and would publish
# the key to every visitor.
RESEND_API_KEY=""

# Where submissions are delivered. Defaults to b.kaukenova@gmail.com.
CONTACT_TO="b.kaukenova@gmail.com"

# Sender address. Must be on a domain verified in Resend. Until medsupport.kz is
# verified, onboarding@resend.dev works but only delivers to the Resend account owner.
CONTACT_FROM="onboarding@resend.dev"
